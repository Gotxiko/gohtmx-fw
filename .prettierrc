{
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 160,
    "tabWidth": 4,
    "bracketSameLine": true,
    "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-go-template"],
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "go-template"
            }
        }
    ]
}
