<html lang="<%=locale%>">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="/assets/css/app.css" />
        <script type="module" src="/assets/js/app.js"></script>
    </head>

    <body class="w-full bg-gray-700 font-mono">
        <main
            hx-swap="innerHTML transition:true"
            class="flex h-auto w-full flex-col items-center justify-center"
        >
            <%- include('partials/Navigation/NavWrapper') %>
            <div class="flex w-full p-4">
                <div
                    class="card h-100 w-4/12 rounded border border-gray-500 bg-gray-600 text-gray-300"
                >
                    <div class="card--title border-b border-gray-500 px-4 py-2">
                        Card title
                    </div>
                    <div class="card--content px-4 py-2">
                        Card contents Card contents Card contents Card contents
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>
