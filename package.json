{
    "name": "express",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "format": "prettier --write . && gofmt -w .",
        "build:assets": "cp -R src/assets/img dist/assets/ && cp -R src/assets/svg dist/assets/",
        "build:css": "bun x tailwindcss -m -i src/assets/css/app.css -o dist/assets/styles.css",
        "build:js": "esbuild src/assets/js/app.ts --outfile=dist/assets/scripts.js --bundle --minify",
        "build": "bun x tailwindcss -m -i src/assets/css/app.css -o dist/assets/styles.css && esbuild src/assets/js/app.ts --outfile=dist/assets/scripts.js --bundle --minify && cp -R src/assets/img dist/assets/ && cp -R src/assets/svg dist/assets/ && cp -R src/assets/fonts dist/assets/",
        "start:air": "~/go/bin/air",
        "watch:css": "bun x tailwindcss -m -i src/assets/css/app.css -o dist/assets/styles.css --watch",
        "watch:js": "esbuild src/assets/js/app.ts --outfile=dist/assets/scripts.js --bundle --minify --watch",
        "watch": "npm-run-all --parallel watch:css watch:js",
        "watch:server": "bun run start:air",
        "start": "pm2 start gtz-app --name www",
        "build:start": "bun run build && go build -o gtz-app server/server.go && bun run start",
        "build:restart": "bun run build && go build -o gtz-app server/server.go && pm2 restart www",
        "restart": "pm2 restart www",
        "delete-all": "pm2 delete all"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@analytics/google-tag-manager": "^0.5.5",
        "analytics": "^0.8.11",
        "htmx.org": "^1.9.10",
        "vanilla-cookieconsent": "^3.0.0"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "@tailwindcss/cli": "^4.0.0-alpha.8",
        "buffer": "^6.0.3",
        "clean-css-cli": "^5.6.3",
        "esbuild": "0.20.1",
        "postcss-import": "^16.0.1",
        "prettier": "^3.2.5",
        "prettier-plugin-go-template": "^0.0.15",
        "prettier-plugin-tailwindcss": "^0.5.12",
        "process": "^0.11.10",
        "sharp": "^0.33.2",
        "style-loader": "^3.3.4",
        "svgo": "^3.2.0",
        "tailwindcss": "^4.0.0-alpha.8"
    }
}
