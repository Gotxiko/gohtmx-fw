{
    "name": "express",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "format": "prettier --write . && gofmt -w .",
        "watch": "parcel watch src/**/*.scss src/**/*.js --dist-dir dist/assets",
        "build": "parcel build src/**/*.scss src/**/*.js --dist-dir dist/assets --no-scope-hoist",
        "start": "pm2 start gtz-app --name www",
        "build:start": "npm run build && go build -o gtz-app start.go && npm run start",
        "build:restart": "npm run build && go build -o gtz-app start.go && pm2 restart www",
        "restart": "pm2 restart www",
        "delete-all": "pm2 delete all"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@analytics/google-tag-manager": "^0.5.5",
        "analytics": "^0.8.11",
        "htmx.org": "^1.9.10",
        "vanilla-cookieconsent": "^3.0.0"
    },
    "devDependencies": {
        "@parcel/transformer-sass": "^2.11.0",
        "buffer": "^6.0.3",
        "cssnano": "^6.0.3",
        "htmlnano": "^2.1.0",
        "lightningcss": "^1.23.0",
        "parcel": "^2.11.0",
        "parcel-transformer-ejs": "^1.0.1",
        "postcss": "^8.4.35",
        "postcss-cli": "^11.0.0",
        "postcss-import": "^16.0.1",
        "prettier": "^3.2.5",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "process": "^0.11.10",
        "sharp": "^0.33.2",
        "style-loader": "^3.3.4",
        "svgo": "^3.2.0",
        "tailwindcss": "^3.4.1"
    }
}
